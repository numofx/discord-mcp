SPRING_PROFILES_ACTIVE=http
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=OPTIONAL_DEFAULT_SERVER_ID

# Reaction-role verification gate. Leave blank to disable.
# Reacting to VERIFY_MESSAGE_ID with VERIFY_EMOJI grants VERIFY_ROLE_ID.
VERIFY_MESSAGE_ID=
VERIFY_EMOJI=
VERIFY_ROLE_ID=
# Set true to also strip the role when the reaction is removed.
VERIFY_REMOVE_ON_UNREACT=false

# Support tickets. Leave blank to disable.
# The "Open ticket" button creates a private channel under TICKETS_CATEGORY_ID,
# visible to its author and TICKET_STAFF_ROLE_ID.
TICKETS_CATEGORY_ID=
TICKET_STAFF_ROLE_ID=
# Staff channel to announce new tickets in. Blank disables the announcement.
TICKET_LOG_CHANNEL_ID=
# Set true to ping the staff role instead of just naming it.
TICKET_LOG_PING_STAFF=false
# Channel whose topic stores the ticket counter. Defaults to TICKET_LOG_CHANNEL_ID.
TICKET_COUNTER_CHANNEL_ID=
